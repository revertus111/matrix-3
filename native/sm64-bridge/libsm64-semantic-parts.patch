+
+/* verified-static: pinned Mario geo animated-part order is root=0, pelvis=1,
+ * torso=2, head=3, left chain=4..7, right chain=8..11, legs=12..19.
+ * Switch nodes visit exactly one hand. Named DL checks fail closed if the pin
+ * changes. Offsets affect local evaluated channels, never persistent AnimInfo.
+ */
+void gfx_adapter_combat_rotation(int joint, struct GraphNodeAnimatedPart *node, Vec3s rotation)
+{
+    int slot = -1;
+    void *dl = node->displayList;
+    struct SM64MarioCombatPose *pose = s_outBuffers->combatPose;
+    if (pose == NULL) return;
+    if (joint == 2 && (dl == mario_torso || dl == mario_medium_poly_torso
+            || dl == mario_low_poly_torso || dl == mario_metal_torso_shared_dl
+            || dl == mario_metal_medium_poly_torso || dl == mario_metal_low_poly_torso))
+        slot = 0;
+    if (joint == 9 && (dl == mario_right_arm || dl == mario_medium_poly_right_arm
+            || dl == mario_low_poly_right_arm || dl == mario_right_arm_shared_dl
+            || dl == mario_medium_poly_right_arm_shared_dl || dl == mario_low_poly_right_arm_shared_dl))
+        slot = 1;
+    if (joint == 10 && (dl == mario_right_forearm_shared_dl
+            || dl == mario_medium_poly_right_forearm_shared_dl
+            || dl == mario_low_poly_right_forearm_shared_dl))
+        slot = 2;
+    if (joint == 11 && s_combatJointMask == 7 && node->translation[0] == 60
+            && node->translation[1] == 0 && node->translation[2] == 0)
+        slot = 3;
+    if (slot < 0) return;
+    s_combatJointMask |= 1u << slot;
+    for (int axis = 0; axis < 3; axis++)
+        rotation[axis] = (int16_t)((uint16_t)rotation[axis] + (uint16_t)pose->rotation[slot][axis]);
+}
+
+void gfx_adapter_combat_socket(int joint, struct GraphNodeAnimatedPart *node, Mat4 matrix)
+{
+    (void)node;
+    if (joint == 11 && s_combatJointMask == 15 && s_outBuffers->combatPose != NULL) {
+        memcpy(s_outBuffers->combatPose->rightHand, matrix, sizeof(Mat4));
+        s_outBuffers->combatPose->rightHandAvailable = 1;
+    }
+}
