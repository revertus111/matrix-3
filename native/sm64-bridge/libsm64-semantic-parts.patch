+static uint8_t classify_mario_display_list(void *dl)
+{
+    if (dl == (void *)mario_face_part_cap_on_dl
+            || dl == (void *)mario_face_part_cap_off_dl
+            || dl == (void *)mario_low_poly_face_part_cap_on_dl
+            || dl == (void *)mario_low_poly_face_part_cap_off_dl) {
+        return SM64_MARIO_GEOMETRY_PART_FACE;
+    }
+    if (dl == (void *)mario_eyes_cap_on_dl
+            || dl == (void *)mario_eyes_cap_off_dl
+            || dl == (void *)mario_low_poly_eyes_cap_on_dl
+            || dl == (void *)mario_low_poly_mario_eyes_cap_off_dl) {
+        return SM64_MARIO_GEOMETRY_PART_EYES;
+    }
+    if (dl == (void *)mario_mustache_cap_on_dl
+            || dl == (void *)mario_mustache_cap_off_dl
+            || dl == (void *)mario_low_poly_mustache_cap_on_dl
+            || dl == (void *)mario_low_poly_mustache_cap_off_dl) {
+        return SM64_MARIO_GEOMETRY_PART_MUSTACHE;
+    }
+    if (dl == (void *)mario_m_logo_dl
+            || dl == (void *)mario_face_cap_dl
+            || dl == (void *)mario_low_poly_mario_m_logo_dl
+            || dl == (void *)mario_low_poly_face_cap_dl) {
+        return SM64_MARIO_GEOMETRY_PART_CAP;
+    }
+    if (dl == (void *)mario_hair_sideburn_cap_on_dl
+            || dl == (void *)mario_hair_sideburn_cap_off_dl) {
+        return SM64_MARIO_GEOMETRY_PART_HAIR_SIDEBURN;
+    }
+    if (dl == (void *)mario_face_back_hair_cap_on_dl
+            || dl == (void *)mario_face_hair_cap_off_dl
+            || dl == (void *)mario_low_poly_face_back_hair_cap_on_dl
+            || dl == (void *)mario_low_poly_face_hair_cap_off_dl) {
+        return SM64_MARIO_GEOMETRY_PART_HAIR_BACK;
+    }
+    return SM64_MARIO_GEOMETRY_PART_UNKNOWN;
+}
 
